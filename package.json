{
  "name": "superdrive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @superdrive/api --filter @superdrive/web dev",
    "build": "pnpm --filter @superdrive/web build && pnpm --filter @superdrive/api build",
    "start": "node --disable-warning=ExperimentalWarning apps/api/dist/server.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @superdrive/api test"
  }
}
