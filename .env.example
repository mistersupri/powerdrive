# --- Required in production -------------------------------------------------
APP_URL=https://drive.example.com
# Credential encryption key(s), newest first: base64 of 32 bytes, optionally prefixed with a version (v1:…)
#   openssl rand -base64 32   ->   ENCRYPTION_MASTER_KEY=<output>      (the "v1:" prefix is optional)
# To rotate: put a new "v2:..." in front and keep v1 after it, e.g.  v2:AAA...,v1:BBB...
ENCRYPTION_MASTER_KEY=
DOMAIN=drive.example.com

# --- OAuth apps (only for the providers you use) ----------------------------
# Redirect URIs to register:  ${APP_URL}/api/v1/storages/{google-drive|onedrive|dropbox}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# --- Storage layout ----------------------------------------------------------
# The folder behind the "Semua file" page (the built-in storage). Defaults to ${DATA_DIR}/files.
# Mount your volume here, e.g.  - /mnt/ssd/files:/data/files   (docker-compose.yml)
UPLOADS_DIR=/data/files
TRASH_RETENTION_DAYS=30            # deleted items stay recoverable this long

# --- Public share links under heavy use --------------------------------------
STAGING_MAX_BYTES=0                # cap on bytes waiting in staging across all uploads (0 = unlimited). e.g. 53687091200 = 50 GB
MAX_ACTIVE_UPLOADS_PER_IP=100      # simultaneous uploads from one address

# --- Behaviour ---------------------------------------------------------------
ALLOW_REGISTRATION=true            # false = invitation only (the first account is always allowed)
ALLOW_PRIVATE_HOSTS=false          # true lets S3/WebDAV endpoints point at LAN addresses (NAS, MinIO)
TRANSFER_MAX_CONCURRENCY=3         # simultaneous transfers per workspace
TRANSFER_RETRY_ATTEMPTS=5
UPLOAD_CHUNK_SIZE=16777216         # bytes per browser upload request
UPLOAD_MAX_FILE_SIZE=0             # 0 = unlimited
THUMBNAIL_CONCURRENCY=             # default = CPU count
