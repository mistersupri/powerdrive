{
  "name": "@superdrive/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "start": "node --disable-warning=ExperimentalWarning dist/server.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/lib-storage": "^3.1168.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@node-rs/argon2": "^2.2.2",
    "@superdrive/shared": "workspace:*",
    "archiver": "^8.0.0",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "mime-types": "^3.0.2",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2": "^1.15.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "webdav-server": "^2.6.3"
  }
}
