{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": false, "esModuleInterop": true,
    "skipLibCheck": true, "noEmit": true, "types": ["node"], "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
